<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="ApexCounter"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ApexCounter;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="60" name=".APEXCOUNTER" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <globalization culture="en-US" uiCulture="en-US" />
    <sessionState mode="InProc" timeout="60" />
    <httpRuntime requestValidationMode="4.0" />
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="WebResource.axd">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
