# Copy to .env and fill in. Never commit .env.

# Which voice path?  sonic  |  wispr_kokoro
VOICE_PATH=sonic

# --- Path A: Amazon Nova Sonic (Bedrock) ---
AWS_REGION=us-east-1
# Use the classroom IAM user, or a Bedrock API key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# Model ID — confirm in the Bedrock console. Nova 2.5 if enabled.
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
SONIC_VOICE=tiffany

# --- Path B: Wispr Flow STT + Kokoro TTS ---
# Wispr: https://api-docs.wisprflow.ai/rest_api_transcribe
# WISPR_API_KEY=
# Kokoro is local (pip install kokoro). No TTS key.
# Voices: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
# lang_code: a=en-US  e=es  h=hi
KOKORO_LANG=a
KOKORO_VOICE=af_heart

# Optional: LLM for Path B answers (if not using Sonic)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
